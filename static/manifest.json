{
  "manifest_version": 3,
  "name": "Anti-Judol Shield",
  "short_name": "Anti-Judol",
  "version": "1.1.0",
  "description": "Sembunyikan spam judi online (judol) di YouTube & media sosial, dan blokir situs judi. Berjalan di perangkatmu.",
  "homepage_url": "https://github.com/Leon24k/anti-judol",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*",
    "https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*",
    "https://www.twitch.tv/*",
    "https://disqus.com/embed/*",
    "https://www.facebook.com/*", "https://m.facebook.com/*", "https://web.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anti-Judol Shield",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options.html"
}
