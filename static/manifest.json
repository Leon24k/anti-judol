{
  "manifest_version": 3,
  "name": "Anti-Judol Shield",
  "short_name": "Anti-Judol",
  "version": "0.1.0",
  "description": "Blurs online-gambling (judol) promotion in YouTube comments, titles, and live chat in real time.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Anti-Judol Shield" },
  "options_page": "options.html"
}
